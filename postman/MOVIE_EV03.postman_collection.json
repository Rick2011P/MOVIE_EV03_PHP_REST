            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin.movie@example.com\", \"password\": \"ClaveSegura123!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200){pm.collectionVariables.set(\"token\",pm.response.json().token)}"
            ]
          }
        }
      ]
    },
