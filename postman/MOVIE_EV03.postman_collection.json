{
  "info": {
    "name": "MOVIE EV03 PHP REST - Pruebas Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de ejemplos; para CRUD admin promover el usuario de práctica en MySQL y luego login"
